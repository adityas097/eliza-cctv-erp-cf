# Public Client-side Configuration (Safe for Browser)
VITE_SITE_URL=https://cctv.elizainfotech.com

# Supabase Free Plan Configuration (Supports both Modern & Legacy Keys)
# Modern: Provide Project Reference ID (e.g. abcdefghijklmno) or full URL
VITE_SUPABASE_PROJECT_REF=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Modern: Publishable API Key (starts with sb_publishable_...) OR Legacy anon key (starts with eyJ...)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Cloud OAuth 2.0 (Free Tier - Unlimited Web Sign-Ins)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Firebase Cloud Messaging - Spark Plan (Free Tier Web Push)
VITE_FIREBASE_PROJECT_ID=eliza-cctv-prod
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Server-Side / Function Secrets (NEVER expose to browser / commit to Git)
# Stored encrypted in Supabase Vault or CI/CD secrets:
# SUPABASE_SECRET_KEY=sb_secret_... (or legacy SUPABASE_SERVICE_ROLE_KEY=eyJ...)
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=re_... (or SMTP_PASSWORD=)
# WHATSAPP_ACCESS_TOKEN=EAAB...
# ORACLE_OCI_KEY=

